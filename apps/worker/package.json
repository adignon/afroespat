{
  "name": "@app/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
