# ─────────────────────────────────────────────────────────────────────────────
# Profil DÉMO des fournisseurs — voir docs/provider-demo.md
#
# Ce fichier se SUPERPOSE à .env (variables de base : base de données, clés de
# chiffrement…). Il sert aux DEUX côtés :
#   · l'API et le worker (PROVIDER_MODE=demo : adaptateurs RÉELS, pointés sur le démo) ;
#   · le serveur démo (`pnpm demo:providers`), qui lit les MÊMES noms de clés.
#
# Usage :   set -a; . ./.env.demo.example; set +a      puis lancer l'API
#           pnpm demo:providers                         (autre terminal)
#
# EN PRODUCTION : supprimer PROVIDER_MODE, poser les VRAIES clés ci-dessous et
# supprimer les *_BASE_URL / S3_ENDPOINT / ANTIVIRUS_HOST (les défauts sont les
# adresses de production). Aucun changement de code. PROVIDER_MODE=demo est
# refusé quand NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────
PROVIDER_MODE=demo
DEMO_BASE_URL=http://localhost:3077

# Twilio (SMS) — numéros d'essai : voir docs/provider-demo.md
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACdemo00000000000000000000000000
TWILIO_AUTH_TOKEN=demo-twilio-auth-token
TWILIO_FROM=+15005550006
TWILIO_BASE_URL=http://localhost:3077            # prod : api.twilio.com (défaut, supprimer)

# Brevo (e-mail)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-demo-brevo-api-key
BREVO_BASE_URL=http://localhost:3077             # prod : api.brevo.com

# Web Push (VAPID) — paire de TEST ; en production : npx web-push generate-vapid-keys
PUSH_PROVIDER=webpush
VAPID_PUBLIC_KEY=BHUeTVgWuISQbsxk-hTE5W2REZyDqLRQmcz-9wu72eK-E4Ku_hEFkObksUBxalQrCi-ggJf0Z61HIt1CzV9DOoE
VAPID_PRIVATE_KEY=s9gJ5FXfMnGawjne7tKPQTwnfHlFRE1qWOIamY7MTrM

# Didit (KYC)
KYC_PROVIDER=didit
DIDIT_API_KEY=demo-didit-api-key
DIDIT_WORKFLOW_ID=demo-didit-workflow
DIDIT_WEBHOOK_SECRET=demo-didit-webhook-secret-0123456789
DIDIT_BASE_URL=http://localhost:3077             # prod : https://verification.didit.me

# Anthropic (modération)
AI_MODERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-demo-anthropic-key
ANTHROPIC_BASE_URL=http://localhost:3077         # prod : https://api.anthropic.com

# Cloudflare Turnstile — clé de test officielle « accepte tout »
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_BASE_URL=http://localhost:3077         # prod : https://challenges.cloudflare.com

# Stockage S3 (mode path-style, signature SigV4 vérifiée par le démo)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:3077
S3_REGION=eu-west-1
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=demo-access-key
S3_SECRET_ACCESS_KEY=demo-secret-key-0123456789abcdef
S3_FORCE_PATH_STYLE=true

# ClamAV — clamd sur le MÊME port que le HTTP du démo
ANTIVIRUS_PROVIDER=clamav
ANTIVIRUS_HOST=localhost
ANTIVIRUS_PORT=3077

# ── Réservé au serveur démo (ignoré par l'API) ──────────────────────────────
# DEMO_PORT=3077
# DEMO_HOST=127.0.0.1
# DEMO_STATE_FILE=/tmp/provider-demo-state.json   # conserve boîte et objets entre redémarrages
# DEMO_DIDIT_WEBHOOK_URL=http://localhost:3001/v1/webhooks/didit
