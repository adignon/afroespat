// ─────────────────────────────────────────────────────────────────────────────
// Module 08 — Parrainage, contacts et messagerie  ·  9 tables
//
// Parrainage : 90 jours, 2 filleuls maximum, L2 requis pour devenir parrain,
// mais la demande est ouverte dès L0 — « créer le lien avant l'avion » (T4).
//
// RÈGLE DURE : le parrainage n'implique jamais d'argent. La modération IA marque
// MONEY_REQUEST dans une conversation de parrainage en priorité 1.
// RÈGLE DURE : aucun compteur public de contacts. Le nombre n'est visible que de soi-même.
//
// Les messages sont chiffrés au repos mais PAS de bout en bout : la modération
// doit pouvoir traiter un signalement (décision T4).
// ─────────────────────────────────────────────────────────────────────────────

enum MentorshipStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  ACTIVE
  ENDED
  CANCELLED
}

enum MentorshipEndReason {
  COMPLETED
  MENTOR_LEFT
  MENTEE_LEFT
  BLOCKED
  ADMIN
}

/// Un contact naît d'une interaction réelle, pas d'un clic.
enum ConnectionOrigin {
  HELP_VALIDATED
  MENTORSHIP
  EVENT
  GUIDE
  MANUAL
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ConversationKind {
  DIRECT
  JOURNEY
  MENTORSHIP
  /// Un membre écrit à l'ÉQUIPE DE SON RÉSEAU — propriétaire et modérateurs actifs.
  ///
  /// 07-reseaux.md ne décrit que le chemin modérateur → membre ; les deux boutons
  /// « Contacter les modérateurs » de la planche « À propos » (A08T, 1036 px et
  /// 390 px) n'avaient donc aucune route. Le porteur a tranché entre un message au
  /// propriétaire seul et une conversation de GROUPE : « fais le bon » — une
  /// réponse collective et traçable, qui ne dépend pas de la disponibilité d'une
  /// seule personne.
  ///
  /// CE N'EST PAS UN SIGNALEMENT. `POST /reports` (13-moderation) va à l'équipe de
  /// la PLATEFORME, ouvre un `moderation_case` et peut suspendre un compte ; ceci
  /// va aux bénévoles d'UN réseau, ne crée aucun dossier, et n'a aucun pouvoir de
  /// sanction. Les confondre donnerait à un désaccord de voisinage le poids d'une
  /// procédure — et inversement.
  ///
  /// Les trois autres kinds ne pouvaient pas servir, et c'est MESURÉ, pas supposé :
  /// `DIRECT` est à DEUX et unique par paire (§5.1) — elle aurait désigné un seul
  /// modérateur et serait entrée en collision avec la conversation privée que les
  /// deux ont peut-être déjà ; `JOURNEY` et `MENTORSHIP` portent chacune une clé
  /// étrangère obligatoire vers un parcours ou un parrainage qui n'existe pas ici.
  COMMUNITY_MODERATION
}

/// Profil de parrain. Niveau L2 requis (présence sur le territoire).
model MentorProfile {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  isAvailable       Boolean @map("is_available")
  /// Défaut 2 — protège les parrains de la saturation (décision T4).
  maxMentees        Int     @default(2) @map("max_mentees")
  activeMenteeCount Int     @default(0) @map("active_mentee_count")

  bio                String?
  /// Types de parcours que le parrain connaît.
  journeyTemplateIds String[] @map("journey_template_ids") @db.Uuid

  completedCount Int      @default(0) @map("completed_count")
  avgRating      Decimal? @map("avg_rating") @db.Decimal(3, 2)

  enabledAt  DateTime  @map("enabled_at") @db.Timestamptz
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  @@map("mentor_profiles")
}

/// Relation parrain / filleul, bornée à 3 mois (tâche mentorship.end_due).
model Mentorship {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mentorUserId String  @map("mentor_user_id") @db.Uuid
  menteeUserId String  @map("mentee_user_id") @db.Uuid
  /// Parcours du filleul : le parrain devient SUPPORTER automatiquement (03 §3.4).
  journeyId    String? @map("journey_id") @db.Uuid

  status         MentorshipStatus
  /// Obligatoire.
  requestMessage String           @map("request_message")

  acceptedAt DateTime?            @map("accepted_at") @db.Timestamptz
  /// accepted_at + 3 mois.
  endsAt     DateTime?            @map("ends_at") @db.Timestamptz
  endedAt    DateTime?            @map("ended_at") @db.Timestamptz
  endReason  MentorshipEndReason? @map("end_reason")

  conversationId String? @map("conversation_id") @db.Uuid

  mentor       User          @relation("MentorshipMentor", fields: [mentorUserId], references: [id], onDelete: Cascade)
  mentee       User          @relation("MentorshipMentee", fields: [menteeUserId], references: [id], onDelete: Cascade)
  journey      Journey?      @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation("MentorshipConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  reviews       MentorshipReview[]
  conversations Conversation[]     @relation("ConversationMentorship")

  @@index([mentorUserId])
  @@index([menteeUserId])
  @@index([status])
  @@map("mentorships")
}

/// Évaluation à la clôture, dans les deux sens. Jamais affichée comme un classement.
model MentorshipReview {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  mentorshipId   String  @map("mentorship_id") @db.Uuid
  reviewerUserId String  @map("reviewer_user_id") @db.Uuid
  revieweeUserId String  @map("reviewee_user_id") @db.Uuid
  /// 1 à 5.
  rating         Int
  comment        String?

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  reviewer   User       @relation("ReviewAuthor", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  reviewee   User       @relation("ReviewSubject", fields: [revieweeUserId], references: [id], onDelete: Cascade)

  @@unique([mentorshipId, reviewerUserId])
  @@index([mentorshipId])
  @@index([revieweeUserId])
  @@map("mentorship_reviews")
}

/// Contact entre deux membres. Paire ordonnée : contrainte user_a_id < user_b_id,
/// posée en SQL dans la migration (Prisma n'exprime pas les CHECK).
model Connection {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userAId String           @map("user_a_id") @db.Uuid
  userBId String           @map("user_b_id") @db.Uuid
  origin  ConnectionOrigin

  originRefType String?   @map("origin_ref_type")
  originRefId   String?   @map("origin_ref_id") @db.Uuid
  /// Retrait automatique sur blocage.
  removedAt     DateTime? @map("removed_at") @db.Timestamptz

  userA User @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  proRecommendations ProRecommendation[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("connections")
}

/// Demande manuelle de contact : motif obligatoire. (La condition de « même ville » a été levée par le porteur — voir `ConnectionsService.request`.)
model ConnectionRequest {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fromUserId String                  @map("from_user_id") @db.Uuid
  toUserId   String                  @map("to_user_id") @db.Uuid
  message    String
  status     ConnectionRequestStatus
  decidedAt  DateTime?               @map("decided_at") @db.Timestamptz

  fromUser User @relation("ConnectionRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@map("connection_requests")
}

/// Blocage entre membres. JAMAIS notifié au bloqué.
/// Effet : retire le contact, retire de l'équipe d'un parcours, masque
/// réciproquement dans la recherche (règle dure 11 §2).
model Block {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blockerUserId String @map("blocker_user_id") @db.Uuid
  blockedUserId String @map("blocked_user_id") @db.Uuid

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
  @@map("blocks")
}

/// Fil de messages : direct, groupe de parcours, parrainage.
/// La conversation JOURNEY est créée dès l'ouverture d'un parcours (03 §3.1) —
/// c'est pourquoi ces trois tables appartiennent au lot 2, pas au lot 7.
model Conversation {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  kind          ConversationKind
  journeyId     String?          @map("journey_id") @db.Uuid
  mentorshipId  String?          @map("mentorship_id") @db.Uuid
  /// Le réseau dont on contacte l'équipe. Renseigné pour COMMUNITY_MODERATION seul.
  communityId   String?          @map("community_id") @db.Uuid
  /// QUI a ouvert le fil — le demandeur, et non l'un des modérateurs.
  ///
  /// SANS CETTE COLONNE L'IDEMPOTENCE EST INEXPRIMABLE, et c'est la raison
  /// d'être du couple unique ci-dessous. « Le fil de ce membre sur ce réseau » ne
  /// peut pas se chercher par la liste des membres : un modérateur appartient à
  /// TOUS les fils de son réseau, donc chercher « la conversation de ce réseau
  /// dont je suis membre » lui rendrait celle d'un autre demandeur — et son
  /// second clic l'aurait fait écrire dans le fil de quelqu'un d'autre.
  ///
  /// `onDelete: SetNull` et non `Cascade` : §11 anonymise, et un compte supprimé
  /// ne doit pas emporter un échange que l'équipe du réseau a peut-être à garder.
  /// Le couple unique s'en trouve relâché — deux lignes à `NULL` ne se heurtent
  /// pas en PostgreSQL — ce qui est exactement voulu : un compte supprimé ne doit
  /// pas bloquer le fil d'un autre.
  openedByUserId String?         @map("opened_by_user_id") @db.Uuid
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz

  journey      Journey?    @relation("ConversationJourney", fields: [journeyId], references: [id], onDelete: SetNull)
  mentorship   Mentorship? @relation("ConversationMentorship", fields: [mentorshipId], references: [id], onDelete: SetNull)
  community    Community?  @relation("ConversationCommunity", fields: [communityId], references: [id], onDelete: Cascade)
  openedBy     User?       @relation("ConversationOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)

  members           ConversationMember[]
  messages          Message[]
  journeysAsGroup   Journey[]            @relation("JourneyGroupConversation")
  mentorshipsAsMain Mentorship[]         @relation("MentorshipConversation")

  /**
   * L'IDEMPOTENCE, POSÉE EN BASE ET PAS SEULEMENT DANS LE SERVICE.
   *
   * « Un membre qui clique deux fois ne doit pas ouvrir deux conversations. » Le
   * service cherche d'abord, et c'est ce chemin que l'on emprunte ; mais deux
   * clics SIMULTANÉS passent tous les deux la recherche avant que l'un n'ait
   * créé — et la seule chose qui attrape cette course est la contrainte.
   *
   * Les deux colonnes sont nulles sur toutes les autres conversations, et
   * PostgreSQL considère deux `NULL` comme distincts : la contrainte ne pèse donc
   * que sur les conversations de modération, sans index partiel à maintenir.
   */
  @@unique([communityId, openedByUserId])
  @@index([lastMessageAt])
  @@index([communityId])
  @@map("conversations")
}

model ConversationMember {
  conversationId String @map("conversation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  joinedAt   DateTime  @map("joined_at") @db.Timestamptz
  leftAt     DateTime? @map("left_at") @db.Timestamptz
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz
  isMuted    Boolean   @default(false) @map("is_muted")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

/// Message privé, chiffré au repos (§8.1). Pas de chiffrement de bout en bout en V1.
model Message {
  id        String    @id @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  conversationId String   @map("conversation_id") @db.Uuid
  senderUserId   String   @map("sender_user_id") @db.Uuid
  bodyEncrypted  Bytes    @map("body_encrypted")
  mediaAssetId   String?  @map("media_asset_id") @db.Uuid
  /// La story D'OÙ ce message est parti, quand il vient de l'écran de lecture.
  ///
  /// Le porteur : « Il faut qu'on puisse cliquer sur [la vignette] et aller vers
  /// la story si toujours en ligne. Sinon ça affirme que la story a expiré. »
  ///
  /// La vignette est une CAPTURE — un média indépendant, qui survit à la story.
  /// Sans ce lien, rien ne ramène de l'une à l'autre : la capture est un PNG parmi
  /// d'autres, et le message ne sait pas d'où il vient.
  ///
  /// `onDelete: SetNull` et non `Cascade` : une story supprimée ne doit pas
  /// emporter le message qu'elle a provoqué. Le lien tombe, la vignette reste, et
  /// l'écran dit « cette story a expiré » — ce qui est exactement vrai.
  storyId        String?  @map("story_id") @db.Uuid
  sentAt         DateTime @map("sent_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  story        Story?       @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([senderUserId])
  @@index([sentAt])
  @@map("messages")
}
