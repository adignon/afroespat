// ─────────────────────────────────────────────────────────────────────────────
// Module 13 — Modération et sécurité  ·  6 tables
//
// La modération protège d'abord le segment pré-départ, cible privilégiée des arnaques.
//
// RÈGLE DURE : l'IA ne suspend jamais un compte et ne supprime jamais définitivement
// un contenu. Elle masque et met en file ; un humain tranche.
// RÈGLE DURE : le texte envoyé à l'API IA est toujours passé par redactForModeration
// (téléphones, emails, noms propres remplacés par [TEL] [EMAIL] [NOM]). Un test
// vérifie qu'un numéro et un email ne quittent pas le serveur.
//
// Le texte masqué n'est PAS stocké : seuls les étiquettes, le score et la latence.
// ─────────────────────────────────────────────────────────────────────────────

enum ReportSubjectType {
  POST
  COMMENT
  TOPIC
  GUIDE
  HELP_REQUEST
  HELP_RESPONSE
  HOUSING
  JOB
  PRO
  EVENT
  MESSAGE
  USER
  /// Un réseau entier — « Signaler le réseau » de l'onglet « À propos ». Son
  /// « auteur » est son créateur (`createdByUserId`), nul pour un réseau
  /// automatique : le dossier part alors sans auteur, comme un signalement de
  /// contenu dont l'auteur a supprimé son compte.
  COMMUNITY
  /// AJOUTÉ (lot G) : le pipeline de modération couvre désormais les stories et
  /// les astuces de ville, qui n'avaient pas de type de sujet.
  STORY
  /// 09 §2.3 : une contribution de fiche ville (bon plan, produit, budget,
  /// témoignage) est « signalable ». Son auteur est `city_tips.author_user_id`.
  CITY_TIP
}

enum ReportReason {
  SCAM
  MONEY_REQUEST
  HARASSMENT
  SPAM
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  NEW
  ATTACHED
  RESOLVED
  DISMISSED
}

enum ModerationSource {
  REPORT
  AI
  RISK_SCORE
  AUTO_RULE
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum AiVerdict {
  ALLOW
  QUEUE
  BLOCK
}

enum ModerationResolution {
  KEEP
  HIDE
  REMOVE
  WARN
  SUSPEND
}

enum ModerationActionType {
  HIDE
  UNHIDE
  REMOVE
  WARN
  SUSPEND_USER
  BAN_USER
  DISMISS
  NOTE
}

enum SanctionType {
  WARNING
  SUSPENSION
  BAN
}

enum ScamAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Signalement d'un membre sur un contenu ou un profil. Un par membre et par sujet.
/// Le signaleur reçoit une confirmation, puis une notification à la clôture du
/// dossier — sans détail de la décision.
model Report {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  reporterUserId String            @map("reporter_user_id") @db.Uuid
  subjectType    ReportSubjectType @map("subject_type")
  subjectId      String            @map("subject_id") @db.Uuid
  reason         ReportReason
  /// ≤ 500 caractères.
  details        String?
  status         ReportStatus

  caseId String? @map("case_id") @db.Uuid

  reporter       User            @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([reporterUserId, subjectType, subjectId])
  @@index([reporterUserId])
  @@index([subjectId])
  @@index([status])
  @@index([caseId])
  @@map("reports")
}

/// Dossier de modération : regroupe signalements et détections sur un même sujet.
/// File unique triée par priorité puis SLA. Un dossier assigné depuis 2 h sans
/// action revient en file.
model ModerationCase {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subjectType         ReportSubjectType @map("subject_type")
  subjectId           String            @map("subject_id") @db.Uuid
  subjectAuthorUserId String?           @map("subject_author_user_id") @db.Uuid

  source   ModerationSource
  /// 1 = arnaque ou demande d'argent, contenu bloqué par l'IA, SELF_HARM … 5 = autre.
  priority Int
  status   ModerationCaseStatus

  aiVerdict AiVerdict? @map("ai_verdict")
  aiLabels  String[]   @map("ai_labels")
  aiScore   Decimal?   @map("ai_score") @db.Decimal(4, 3)

  assignedStaffId String?  @map("assigned_staff_id") @db.Uuid
  /// created_at + 24 h ; priorité 1 : + 4 h.
  slaDueAt        DateTime @map("sla_due_at") @db.Timestamptz

  resolution ModerationResolution?
  resolvedAt DateTime?             @map("resolved_at") @db.Timestamptz

  subjectAuthor User?      @relation(fields: [subjectAuthorUserId], references: [id], onDelete: SetNull)
  assignedStaff StaffUser? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  reports    Report[]
  actions    ModerationAction[]
  sanctions  Sanction[]
  scamAlerts ScamAlert[]

  @@index([subjectId])
  @@index([subjectAuthorUserId])
  @@index([priority])
  @@index([status])
  @@index([assignedStaffId])
  @@index([slaDueAt])
  @@map("moderation_cases")
}

/// Actions prises sur un dossier. Table en ajout seul : aucune route de
/// modification ni de suppression.
model ModerationAction {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  caseId  String               @map("case_id") @db.Uuid
  /// Null si action automatique (masquage par l'IA).
  staffId String?              @map("staff_id") @db.Uuid
  action  ModerationActionType
  reason  String

  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  staff          StaffUser?     @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("moderation_actions")
}

/// Sanctions appliquées à un membre. issued_by_staff_id est NON NUL :
/// la décision humaine est obligatoire, l'IA ne sanctionne jamais.
model Sanction {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userId String       @map("user_id") @db.Uuid
  type   SanctionType
  reason String

  startsAt DateTime  @map("starts_at") @db.Timestamptz
  /// Null = définitif (bannissement, réservé au SUPER_ADMIN).
  endsAt   DateTime? @map("ends_at") @db.Timestamptz

  issuedByStaffId String    @map("issued_by_staff_id") @db.Uuid
  caseId          String?   @map("case_id") @db.Uuid
  liftedAt        DateTime? @map("lifted_at") @db.Timestamptz

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedByStaff  StaffUser       @relation(fields: [issuedByStaffId], references: [id], onDelete: Restrict)
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sanctions")
}

/// Alertes arnaques épinglées, rédigées par l'équipe. Ciblables par ville ou par pays.
model ScamAlert {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  title    String
  body     String
  severity ScamAlertSeverity

  cityId    String? @map("city_id") @db.Uuid
  countryId String? @map("country_id") @db.Uuid

  isPinned    Boolean   @map("is_pinned")
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  createdByStaffId String  @map("created_by_staff_id") @db.Uuid
  relatedCaseId    String? @map("related_case_id") @db.Uuid

  city           City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  country        Country?        @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdByStaff StaffUser       @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  relatedCase    ModerationCase? @relation(fields: [relatedCaseId], references: [id], onDelete: SetNull)

  @@index([isPinned])
  @@index([publishedAt])
  @@map("scam_alerts")
}

/// Trace de chaque analyse IA. Le texte masqué n'est PAS stocké.
model AiModerationCheck {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  subjectType ReportSubjectType @map("subject_type")
  subjectId   String            @map("subject_id") @db.Uuid
  model       String
  verdict     AiVerdict
  labels      String[]
  score       Decimal?          @db.Decimal(4, 3)

  /// Vrai : téléphones, emails et noms propres ont été masqués avant l'envoi.
  /// Un check avec redacted = false est un bogue, et le test de la règle dure échoue.
  redacted  Boolean
  latencyMs Int?    @map("latency_ms")

  @@index([subjectId])
  @@index([verdict])
  @@map("ai_moderation_checks")
}

/// Les numéros bannis — 13 §4.2 : « numéros conservés en liste noire (empreinte
/// HMAC) pour empêcher la réinscription », et §11 : « un banni supprimé reste
/// banni ».
///
/// POURQUOI UNE TABLE À PART, et non une colonne de `sanctions`.
///
/// `sanctions.user_id` est `NOT NULL` et en `Cascade` : la sanction DISPARAÎT avec
/// le membre. Or c'est exactement le cas que la règle doit couvrir — tant que le
/// compte banni existe, `phone_numbers.phone_hmac` (unique) suffit déjà à refuser
/// une réinscription, et `resumeAccount` le fait. La faille est ailleurs : dès que
/// le compte est SUPPRIMÉ — droit à l'effacement, ou suppression immédiate par
/// l'équipe — `phone_numbers` est vidée, l'empreinte redevient libre, et le banni
/// se réinscrit avec le même téléphone. Vérifié en base avant d'écrire cette table.
///
/// Elle ne porte donc AUCUNE référence au membre. C'est ce qui lui permet de
/// survivre à sa suppression, et c'est aussi ce qui la rend défendable : elle ne
/// contient rien qui désigne une personne, seulement une empreinte à clé secrète
/// qu'on ne peut pas inverser et qu'on ne peut interroger qu'en connaissant déjà le
/// numéro. Un numéro entré à l'inscription est comparé, il n'est jamais retrouvé.
///
/// CE QUE CELA COÛTE, et qu'il faut assumer : une empreinte de numéro est une
/// donnée personnelle pseudonymisée, conservée sans limite de durée pour empêcher
/// le contournement d'une sanction. C'est un intérêt légitime — la protection des
/// autres membres — et c'est ce que §11 demande explicitement. Le jour où une
/// sanction est levée, la ligne doit être retirée : c'est `unban()` qui le fait.
model BannedPhoneHash {
  /// L'empreinte EST la clé : deux bannissements du même numéro sont le même fait.
  phoneHmac String   @id @map("phone_hmac")
  bannedAt  DateTime @default(now()) @map("banned_at") @db.Timestamptz

  /// La sanction d'origine, SANS clé étrangère — elle s'efface avec le membre,
  /// alors que cette ligne doit rester. Sert à retrouver la décision dans
  /// `audit_logs`, qui lui survit (cinq ans, table en ajout seul).
  sanctionId String? @map("sanction_id") @db.Uuid

  @@index([bannedAt])
  @@map("banned_phone_hashes")
}

/// AJOUT (lot G) — l'état d'un contenu AVANT que la modération ne le masque.
///
/// Le pipeline émet `moderation.content_hidden`, `…_restored`, `…_removed` pour
/// treize types de sujet, et chaque table de contenu dit « masqué » à sa façon
/// (`status`, `moderation_status`, `deleted_at`). Sans mémoire de l'état d'avant,
/// « rétablir » ressusciterait un contenu que son auteur avait supprimé lui-même,
/// ou lèverait un blocage de risque posé par une autre règle. Une ligne ici dit
/// « c'est la modération qui a masqué ceci, et voici ce qu'il fallait remettre » ;
/// sans ligne, un rétablissement ne touche à rien.
model ModerationHide {
  subjectType ReportSubjectType @map("subject_type")
  subjectId   String            @map("subject_id") @db.Uuid
  hiddenAt    DateTime          @default(now()) @map("hidden_at") @db.Timestamptz
  /// L'état à remettre, tel que le module du contenu le comprend (`ACTIVE`,
  /// `PUBLISHED`, `CLEARED`…). Texte libre à dessein : une valeur d'énumération
  /// dépendrait de l'énumération de chaque table.
  priorState  String            @map("prior_state")
  caseId      String?           @map("case_id") @db.Uuid

  @@id([subjectType, subjectId])
  @@map("moderation_hides")
}

/// AJOUT (lot G) — l'alerte INTERNE adressée à un compte de l'équipe.
///
/// `notifications.user_id` désigne un MEMBRE (clé étrangère vers `users`) : une
/// alerte pour l'équipe ne peut pas y entrer, `staff_users` est une autre table.
/// La tâche `moderation.sla_alert` ne faisait que LIRE les dossiers de priorité 1
/// hors délai, et personne n'était prévenu. Une ligne par compte, par dossier et
/// par genre : la tâche tourne toutes les 15 minutes, et le `@@unique` lui évite
/// d'écrire la même alerte quatre fois par heure.
model StaffAlert {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  staffId String  @map("staff_id") @db.Uuid
  /// `SLA_BREACH` aujourd'hui ; ouvert pour d'autres alertes d'équipe.
  kind    String
  title   String
  body    String?
  refType String? @map("ref_type")
  refId   String  @map("ref_id") @db.Uuid

  readAt DateTime? @map("read_at") @db.Timestamptz

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, kind, refId])
  @@index([staffId, readAt])
  @@map("staff_alerts")
}
