// ─────────────────────────────────────────────────────────────────────────────
// Module 07 — Réseaux  ·  9 tables
// Réseaux automatiques (ville, pays d'origine) et d'intérêt : sujets, annonces,
// sondages, albums, rôles contextuels.
//
// Un réseau vide décourage plus qu'il n'attire (décision T4) : 5 invités exigés à
// la création d'un réseau d'intérêt, seuil de 50 membres par ville, archivage
// automatique après 60 jours d'inactivité (INTEREST seulement).
//
// Les modérateurs bénévoles sont un rôle contextuel ici, pas un compte équipe (§7.4).
// ─────────────────────────────────────────────────────────────────────────────

enum CommunityKind {
  CITY
  COUNTRY
  INTEREST
}

enum CommunityVisibility {
  PUBLIC
  ON_REQUEST
  INVITE_ONLY
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  ACTIVE
  PENDING
  INVITED
  BANNED
}

enum TopicStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum TopicPinKind {
  NONE
  RULES
  RESOURCE
  WELCOME
}

/// Réseau de ville, de pays d'origine ou d'intérêt.
/// CITY et COUNTRY sont créés automatiquement à l'activation du référentiel (02 §2).
model Community {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  kind      CommunityKind
  /// Requis si CITY.
  cityId    String?       @map("city_id") @db.Uuid
  /// Requis si COUNTRY.
  countryId String?       @map("country_id") @db.Uuid

  name        String
  slug        String  @unique
  description String?
  /// Intérêt : cuisine, sport, entrepreneuriat…
  category    String?

  visibility      CommunityVisibility
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  coverAssetId    String?             @map("cover_asset_id") @db.Uuid

  memberCount Int             @default(0) @map("member_count")
  status      CommunityStatus

  /// Archivage automatique après 60 jours (INTEREST seulement).
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz

  /// ── L'AVERTISSEMENT D'ARCHIVAGE, ET POURQUOI IL LUI FALLAIT UNE COLONNE ──
  ///
  /// §2.2 : « Le propriétaire reçoit un avertissement à 45 jours », l'archivage
  /// tombant à 60. La tâche `community.archive_inactive` est QUOTIDIENNE : sans
  /// mémoire de l'envoi, elle aurait prévenu le même propriétaire QUINZE fois
  /// de suite — une fois par jour entre le 45e et le 60e. C'est pour cela que §3
  /// annonce cette colonne « ajoutée », et c'est tout ce qu'elle sert à faire.
  ///
  /// NON NULLE = l'avertissement est parti, et à cet instant. Même convention
  /// que `archivedAt` juste au-dessus et que `notifiedAt` sur les annonces.
  ///
  /// ⚠ ELLE EST REMISE À NULL PAR LA RÉACTIVATION ET PAR TOUTE ACTIVITÉ
  /// (`touch()`), et c'est la moitié du mécanisme : un réseau qui se rendort
  /// quinze jours après avoir repris doit être prévenu de nouveau. Un
  /// horodatage jamais effacé aurait fait taire l'avertissement pour toujours
  /// après le premier.
  warningSentAt DateTime? @map("warning_sent_at") @db.Timestamptz

  /// ── LES TROIS INTERRUPTEURS DE LA CARTE « PARAMÈTRES » DE « GÉRER » ──────
  ///
  /// Le porteur : « les paramètres et leur réel application dans le réseau ».
  /// La planche les dessinait sans qu'aucune colonne ne les porte ; chacun est
  /// maintenant APPLIQUÉ par le serveur, pas seulement affiché :
  ///
  ///   · `postsRequireApproval` — la première publication d'un membre ordinaire
  ///     attend la validation d'un modérateur (`Post.awaitingApproval`) ;
  ///   · `pollsOpenToMembers`  — faux = seule l'équipe crée des sondages, dans le
  ///     fil comme par `POST /communities/:id/polls` ;
  ///   · `albumOpenToMembers`  — faux = seule l'équipe ajoute des photos.
  ///
  /// Les DÉFAUTS sont ceux que la planche dessine — validation éteinte, les deux
  /// autres allumés — et ce sont aussi ceux du comportement d'avant la colonne :
  /// la migration ne change rien aux réseaux existants.
  postsRequireApproval Boolean @default(false) @map("posts_require_approval")
  pollsOpenToMembers   Boolean @default(true) @map("polls_open_to_members")
  albumOpenToMembers   Boolean @default(true) @map("album_open_to_members")

  /// Les « Règles du réseau » de l'onglet « À propos » — au plus huit, dans
  /// l'ordre où le propriétaire les range (la planche d'édition écrit « 4 SUR 8 »).
  rules String[] @default([])

  city       City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  country    Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  coverAsset MediaAsset? @relation("CommunityCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  members         CommunityMember[]
  topics          Topic[]
  announcements   CommunityAnnouncement[]
  polls           Poll[]
  albums          Album[]
  posts           Post[]
  events          Event[]
  searchDocuments SearchDocument[]
  /// Les fils « Contacter les modérateurs » ouverts sur ce réseau (08 §5.1).
  /// Un par demandeur ; le modèle vit dans `08-mentorship-messaging.prisma`.
  moderationConversations Conversation[] @relation("ConversationCommunity")

  @@index([kind])
  @@index([cityId])
  @@index([countryId])
  @@index([status])
  @@index([lastActivityAt])
  @@map("communities")
}

model CommunityMember {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  communityId String                @map("community_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  role        CommunityMemberRole
  status      CommunityMemberStatus
  joinedAt    DateTime?             @map("joined_at") @db.Timestamptz

  /// ── LA SOURDINE — UNE PRÉFÉRENCE PERSONNELLE, PAS DE LA MODÉRATION ──────
  ///
  /// §2.5 : « Un membre peut mettre un réseau en sourdine : plus de
  /// notifications, le réseau reste dans sa liste. » Elle vit donc sur la ligne
  /// d'ADHÉSION et non sur le réseau : deux membres du même réseau n'ont pas la
  /// même préférence, et c'est exactement ce que cette colonne dit.
  ///
  /// `@default(false)` est ce qui rend la migration additive : les adhésions
  /// déjà en base n'ont jamais demandé le silence, et `NOT NULL DEFAULT false`
  /// leur donne la bonne valeur sans qu'aucune ligne soit à écrire.
  ///
  /// ⚠ ELLE EST LUE PAR `notifications.events.ts` (`onCommunityAnnouncement`) —
  /// §2.3 : « notification à tous les membres NON EN SOURDINE ». C'est le seul
  /// endroit du dépôt où cette colonne décide de quelque chose, et c'est la
  /// raison pour laquelle elle existe : avant elle, « Notifier » réveillait ceux
  /// qui avaient demandé le silence, faute d'avoir où l'écrire.
  ///
  /// C'est le réseau que l'on met en sourdine, jamais un membre : il n'existe
  /// AUCUN geste pour poser la sourdine de quelqu'un d'autre, et le service le
  /// refuse (`MUTE_SELF_ONLY`).
  muted Boolean @default(false)

  /// ── QUI A INVITÉ, ET CE QUE CELA PERMETTRA DE DIRE ──────────────────────
  ///
  /// §3 l'annonce « ajoutée ». Elle est écrite aux DEUX endroits où une
  /// invitation naît : `POST /communities` (les cinq `inviteHandles` exigés à la
  /// création) et `POST /communities/:id/invite`.
  ///
  /// NULLABLE, et il faut qu'elle le soit : une adhésion AUTOMATIQUE — le réseau
  /// de sa ville, celui de son pays d'origine — n'a pas d'inviteur, pas plus
  /// qu'une adhésion spontanée à un réseau `PUBLIC`. Une colonne obligatoire
  /// aurait exigé de désigner un inviteur fictif pour la majorité des lignes.
  ///
  /// `onDelete: SetNull` plutôt que `Cascade` : la suppression du compte de
  /// l'inviteur ne doit PAS emporter l'adhésion de l'invité. 07 §8 ne parle que
  /// des adhésions DU membre supprimé ; celles qu'il a provoquées restent.
  invitedByUserId String? @map("invited_by_user_id") @db.Uuid

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("CommunityMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Nommée explicitement : Prisma exige un nom dès qu'un modèle pointe DEUX
  /// fois le même autre modèle, et `user` ci-dessus est la première.
  invitedBy User?     @relation("CommunityMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  /// Le filtre de `onCommunityAnnouncement` : « les membres ACTIFS non en
  /// sourdine de ce réseau ». Sans cet index il balaie toutes les adhésions du
  /// réseau pour en écarter une poignée.
  @@index([communityId, status, muted])
  @@index([invitedByUserId])
  @@map("community_members")
}

/// Sujet persistant : structure forum, affichage en cartes.
model Topic {
  id        String    @id @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  communityId  String       @map("community_id") @db.Uuid
  authorUserId String       @map("author_user_id") @db.Uuid
  title        String
  body         String
  status       TopicStatus
  pinKind      TopicPinKind @map("pin_kind")

  replyCount  Int       @default(0) @map("reply_count")
  lastReplyAt DateTime? @map("last_reply_at") @db.Timestamptz

  /// Question déplacée depuis le fil global vers ce réseau.
  originPostId String? @map("origin_post_id") @db.Uuid

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  originPost Post?     @relation("TopicOriginPost", fields: [originPostId], references: [id], onDelete: SetNull)

  postsMovedHere Post[] @relation("PostMovedToTopic")

  @@index([communityId])
  @@index([authorUserId])
  @@index([status])
  @@index([lastReplyAt])
  @@map("topics")
}

/// Annonce du créateur, notifiée à tous les membres du réseau.
///
/// ── LES DEUX COLONNES AJOUTÉES, ET POURQUOI LE MODÈLE ÉTAIT EN DEÇÀ ───────
///
/// La maquette (`docs/template/03 Accueil v2.dc.html`, planche « ADMIN ·
/// ANNONCE », les DEUX largeurs) dessine QUATRE contrôles : un titre, un corps,
/// « Épingler en haut du fil » et « Notifier les 890 membres ». Le modèle n'en
/// portait que deux — `body` et `notifiedAt` — et `createAnnouncementSchema`
/// n'acceptait que `{ body }`. Ce n'était donc pas un oubli de branchement mais
/// un écart de CONTRAT : deux des quatre contrôles n'avaient nulle part où
/// s'écrire. Les deux colonnes sont ajoutées, et l'écart est fermé.
///
/// `title` EST NULLABLE, et il devait l'être : les annonces déjà publiées n'en
/// ont pas, et une colonne obligatoire aurait exigé une valeur inventée pour
/// chacune. Une annonce sans titre reste donc une annonce valide — ce qui est
/// aussi ce que la planche permet, puisqu'elle ne marque pas le champ requis.
///
/// `pinnedAt` EST UN HORODATAGE ET NON UN BOOLÉEN, exactement comme `notifiedAt`
/// juste à côté. Deux raisons, et la seconde est la vraie : le modèle porte déjà
/// cette convention (un instant nul = le fait n'a pas eu lieu), et un instant
/// dit QUAND, ce qu'un booléen ne dira jamais — « épinglé depuis quand » est la
/// question qu'on pose d'un épinglage, et la réponse est gratuite ici.
///
/// ⚠ L'ÉPINGLAGE EST EXCLUSIF — une seule annonce épinglée par réseau à la fois,
/// et c'est le SERVICE qui le tient (`createAnnouncement` déépingle les autres
/// dans la même transaction), pas une contrainte SQL : un index unique partiel
/// sur `(community_id) WHERE pinned_at IS NOT NULL` ferait ÉCHOUER la création
/// d'une seconde annonce épinglée au lieu de remplacer la première, ce qui n'est
/// pas ce que « Épingler en haut du fil » promet. Le raisonnement entier est
/// écrit au-dessus de `createAnnouncement`.
model CommunityAnnouncement {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  communityId  String    @map("community_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  /// Le titre que la planche dessine. Nul sur les annonces d'avant ce lot.
  title        String?
  body         String
  /// Non nul = épinglée en haut du fil, et depuis cet instant. Exclusif par réseau.
  pinnedAt     DateTime? @map("pinned_at") @db.Timestamptz
  notifiedAt   DateTime? @map("notified_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([communityId])
  /// Retrouver l'annonce épinglée d'un réseau sans balayer toutes ses annonces.
  @@index([communityId, pinnedAt])
  @@map("community_announcements")
}

/// Sondage — d'un RÉSEAU (07 §2.3) ou d'une PUBLICATION du fil (04 §2.4).
///
/// ── POURQUOI LES DEUX RATTACHEMENTS VIVENT DANS LE MÊME MODÈLE ─────────────
///
/// Le porteur voulait le sondage du composeur du fil, que la maquette dessine
/// depuis le début (« Créer un sondage », et la carte de publication a son bloc
/// `poll`). Le mécanisme existait ENTIER — création à 2–8 options, vote
/// modifiable, résultats masqués avant vote, clôture — mais `community_id` était
/// obligatoire : un sondage ne pouvait appartenir qu'à un réseau.
///
/// Un second modèle `PostPoll` aurait dupliqué les options, les votes, le compte
/// par option et les quatre règles de visibilité. On rend donc le rattachement
/// FACULTATIF des deux côtés, et EXCLUSIF : la contrainte `polls_rattachement`
/// (migration) exige exactement l'un des deux. C'est ce qui empêche un sondage
/// orphelin — invisible et invotable — ou un sondage à deux maîtres.
model Poll {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// Null quand le sondage est celui d'une publication.
  communityId String? @map("community_id") @db.Uuid
  /// Null quand le sondage est celui d'un réseau. `@unique` : « un seul par
  /// publication », règle que la maquette énonce en toutes lettres.
  postId       String?   @unique @map("post_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  question     String
  isMultiple   Boolean   @map("is_multiple")
  closesAt     DateTime? @map("closes_at") @db.Timestamptz

  /// ── LES DEUX RÉGLAGES QUE LA MAQUETTE DESSINE ───────────────────────────
  ///
  /// Ils étaient DEUX INTERRUPTEURS INERTES, et c'était défendable : le produit
  /// imposait les deux règles à tout le monde. Le porteur a tranché autrement —
  /// « non, fais de ça un réglage » — et chacun devient donc une colonne.
  ///
  /// `resultsAfterVote` : vrai (le défaut) = les comptes restent masqués tant que
  /// le lecteur n'a pas voté et que le sondage n'est pas clos. C'est l'ancien
  /// comportement, donc les sondages déjà créés ne changent pas d'un pouce. Faux =
  /// les résultats sont visibles tout de suite.
  ///
  /// `isAnonymous` : vrai (le défaut) = seuls les totaux sortent de l'API. Faux =
  /// la réponse nomme les votants de chaque option. C'est une décision de
  /// CONFIDENTIALITÉ, et c'est pour cela que le défaut est le silence : un sondage
  /// créé sans rien dire ne nomme personne.
  resultsAfterVote Boolean @default(true) @map("results_after_vote")
  isAnonymous      Boolean @default(true) @map("is_anonymous")

  community Community?   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  options   PollOption[]

  @@index([communityId])
  @@index([postId])
  @@map("polls")
}

model PollOption {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  pollId    String @map("poll_id") @db.Uuid
  label     String
  position  Int
  voteCount Int    @default(0) @map("vote_count")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  pollOptionId String @map("poll_option_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
  @@index([pollOptionId])
  @@map("poll_votes")
}

/// Album partagé d'un réseau, souvent lié à un événement.
/// Photos réelles d'événements ou aucune image — jamais d'illustration générique (T1 §6).
model Album {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  communityId     String  @map("community_id") @db.Uuid
  eventId         String? @map("event_id") @db.Uuid
  title           String
  createdByUserId String  @map("created_by_user_id") @db.Uuid

  community Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  photos    AlbumPhoto[]

  @@index([communityId])
  @@map("albums")
}

model AlbumPhoto {
  id        String    @id @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  albumId          String  @map("album_id") @db.Uuid
  mediaAssetId     String  @map("media_asset_id") @db.Uuid
  uploadedByUserId String  @map("uploaded_by_user_id") @db.Uuid
  caption          String?

  album      Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("album_photos")
}
