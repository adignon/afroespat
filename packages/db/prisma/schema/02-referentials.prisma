// ─────────────────────────────────────────────────────────────────────────────
// Module 02 — Référentiels  ·  5 tables
// Données administrées par l'équipe, lues par tous les modules. Aucune écriture membre.
// Porte la logique mono-pays au lancement : activer un pays est une écriture en
// back-office, jamais un déploiement (02-referentiels.md §2.1).
// ─────────────────────────────────────────────────────────────────────────────

enum CountryKind {
  ORIGIN
  DESTINATION
  BOTH
}

/// Pays d'origine et de destination. Un pays inactif n'apparaît nulle part côté
/// membres, et son indicatif est refusé à l'envoi d'OTP.
model Country {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  iso2      String      @unique
  nameFr    String      @map("name_fr")
  /// Ex. +229. Sert à autoriser l'indicatif avant tout envoi de SMS.
  dialCode  String      @map("dial_code")
  kind      CountryKind
  isActive  Boolean     @map("is_active")
  sortOrder Int         @map("sort_order")

  /// Le nombre de chiffres d'un numéro NATIONAL dans ce pays — 8 au Togo, 9 en
  /// France, 10 au Bénin depuis la renumérotation de 2023.
  ///
  /// Le porteur : « il faut la validation du numéro selon le pays. Backend et
  /// frontend aussi pour valider le format. »
  ///
  /// LA RÈGLE VIT DANS LE RÉFÉRENTIEL, PAS DANS LE CODE, et c'est délibéré : un
  /// plan de numérotation change — celui du Bénin l'a fait en 2023, celui de la
  /// Côte d'Ivoire en 2021 — et l'équipe doit pouvoir le corriger en back-office
  /// sans déploiement, comme elle corrige une ville ou un pays (02 §2.1).
  ///
  /// NULL = « on ne sait pas » : le numéro n'est alors contrôlé que par la forme
  /// internationale (E.164, 7 à 15 chiffres). Refuser faute de règle bloquerait
  /// l'inscription d'un pays qu'on vient d'ouvrir.
  phoneNationalLength Int? @map("phone_national_length")

  // Colonne ajoutée par 02-referentiels.md §3.
  /// Ville proposée par défaut à l'onboarding pour ce pays de destination.
  defaultCityId String? @map("default_city_id") @db.Uuid

  defaultCity City? @relation("CountryDefaultCity", fields: [defaultCityId], references: [id], onDelete: SetNull)

  cities                  City[]                   @relation("CityCountry")
  users                   User[]
  phoneNumbers            PhoneNumber[]
  templateVersions        JourneyTemplateVersion[]
  journeys                Journey[]
  guides                  Guide[]
  communities             Community[]
  searchDocuments         SearchDocument[]
  scamAlerts              ScamAlert[]
  placementsAsOrigin      PartnerPlacement[]       @relation("PlacementOriginCountry")
  placementsAsDestination PartnerPlacement[]       @relation("PlacementDestinationCountry")
  otpChallenges           OtpChallenge[]

  @@index([isActive])
  @@map("countries")
}

/// Villes. Maille géographique la plus fine de la plateforme : aucune position
/// individuelle n'est jamais collectée (règle dure §1.2).
model City {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  countryId String  @map("country_id") @db.Uuid
  name      String
  slug      String  @unique
  region    String?

  /// Centre-ville, saisi à la main. Sert au tri par proximité (haversine) — pas de PostGIS.
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  /// Une ville inactive est sélectionnable à l'inscription mais n'a ni réseau,
  /// ni carte, ni fiche. Activée par l'équipe, en général à 20 membres.
  isActive    Boolean @map("is_active")
  /// Dénormalisé — recalculé chaque nuit par city.member_count_recompute.
  memberCount Int     @default(0) @map("member_count")

  /// Fusion de doublons : redirige membres et contenus. Irréversible.
  mergedIntoCityId String? @map("merged_into_city_id") @db.Uuid

  // Colonnes ajoutées par 02-referentiels.md §3.
  postalPrefix String?   @map("postal_prefix")
  activatedAt  DateTime? @map("activated_at") @db.Timestamptz

  country        Country @relation("CityCountry", fields: [countryId], references: [id], onDelete: Restrict)
  mergedIntoCity City?   @relation("CityMerge", fields: [mergedIntoCityId], references: [id], onDelete: SetNull)
  mergedFrom     City[]  @relation("CityMerge")

  defaultForCountries Country[]          @relation("CountryDefaultCity")
  users               User[]
  journeys            Journey[]
  posts               Post[]
  stories             Story[]
  guides              Guide[]
  helpRequests        HelpRequest[]
  communities         Community[]
  cityTips            CityTip[]
  impactQuotes        ImpactQuote[]
  events              Event[]
  housingListings     HousingListing[]
  housingPriceMedians HousingPriceMedian[]
  jobListings         JobListing[]
  proProfileCities    ProProfileCity[]
  searchDocuments     SearchDocument[]
  searchZeroResults   SearchZeroResult[]
  scamAlerts          ScamAlert[]

  @@index([countryId])
  @@index([isActive])
  @@map("cities")
}

/// Liste fermée. Un membre ne peut pas créer une valeur, seulement la suggérer.
model Language {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  code   String @unique
  nameFr String @map("name_fr")

  userLanguages UserLanguage[]

  @@map("languages")
}

/// 60 à 80 entrées de départ, catégorisées (T3 partie B).
/// Une entrée inactive reste affichée sur les profils qui l'ont déjà.
model Skill {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  nameFr   String  @unique @map("name_fr")
  category String?
  isActive Boolean @map("is_active")

  /// Le membre qui l'a écrite à la main, ou NULL si elle est GLOBALE.
  ///
  /// Le porteur : « Les compétences doivent aussi supporter le free typing qui crée
  /// de nouvelles compétences que les administrateurs peuvent globaliser. On a donc
  /// un createdBy si c'est uniquement pour cet utilisateur. Les autres pourront le
  /// voir sur son profil mais pas le choisir dans le champ des compétences. Mais
  /// quand c'est globalisé tout le monde y a accès. »
  ///
  /// NULL VEUT DONC DIRE « À TOUT LE MONDE », et c'est le sens du référentiel
  /// d'origine : les 60 compétences semées n'appartiennent à personne. Globaliser,
  /// c'est effacer cette colonne — pas ajouter un drapeau de plus.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  userSkills UserSkill[]

  @@index([createdByUserId])
  @@map("skills")
}

/// Métiers de l'annuaire professionnel — liste plus restreinte que les compétences.
model Profession {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  nameFr   String  @unique @map("name_fr")
  category String?
  isActive Boolean @map("is_active")

  proProfiles ProProfile[]

  @@map("professions")
}
