// ─────────────────────────────────────────────────────────────────────────────
// Modules 11 et 12 — Recherche et notifications  ·  6 tables
//
// Recherche en PostgreSQL full-text (tsvector + unaccent + pg_trgm), pas de moteur
// dédié : volume V1 < 100 000 documents, une brique de moins à héberger, et
// l'interface SearchService permet de migrer plus tard (décision T4).
//
// RÈGLE DURE : une requête ne renvoie jamais un document COMMUNITY d'un réseau
// dont le demandeur n'est pas membre, ni un document dont l'auteur est bloqué
// dans un sens ou dans l'autre.
// RÈGLE DURE : aucun email n'est jamais envoyé pour la catégorie SOCIAL.
// ─────────────────────────────────────────────────────────────────────────────

enum SearchSubjectType {
  GUIDE
  TOPIC
  HELP_REQUEST
  HOUSING
  JOB
  EVENT
  USER
  CITY
  PRO
}

/// Les parcours privés ne sont JAMAIS indexés — et les parcours publics non plus
/// (règle dure 03 §3.7 : jamais indexés par la recherche).
enum SearchVisibility {
  PUBLIC
  COMMUNITY
  NONE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

/// Index de recherche dénormalisé. Alimenté par les événements de domaine via la
/// file search-index, jamais écrit à la main.
///
/// La colonne tsv est un tsvector, que Prisma ne modélise pas : elle est déclarée
/// Unsupported et son index GIN est posé en SQL dans la migration.
model SearchDocument {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subjectType SearchSubjectType @map("subject_type")
  subjectId   String            @map("subject_id") @db.Uuid

  title    String
  bodyText String @map("body_text")

  cityId      String? @map("city_id") @db.Uuid
  countryId   String? @map("country_id") @db.Uuid
  /// Renseigné → restreint aux membres du réseau.
  communityId String? @map("community_id") @db.Uuid

  visibility SearchVisibility

  /// unaccent + configuration française ; index GIN posé par migration SQL.
  tsv Unsupported("tsvector")

  city      City?      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  country   Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@unique([subjectType, subjectId])
  @@index([subjectType])
  @@index([cityId])
  @@index([countryId])
  @@index([communityId])
  @@index([visibility])
  @@map("search_documents")
}

/// Recherches sans résultat, anonymisées. Sert au produit (revue hebdomadaire du
/// runbook) et à la proposition « publier la question dans l'entraide ».
model SearchZeroResult {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  queryNormalized String   @map("query_normalized")
  cityId          String?  @map("city_id") @db.Uuid
  occurredOn      DateTime @map("occurred_on") @db.Date
  count           Int      @default(1)

  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@unique([queryNormalized, cityId, occurredOn])
  @@index([queryNormalized])
  @@map("search_zero_results")
}

/// Qui a cherché, en PSEUDONYME — pour compter des PERSONNES et non des recherches.
///
/// POURQUOI CETTE TABLE EXISTE. `search_zero_results.count` compte les RECHERCHES :
/// un seul membre qui cherche trois fois y inscrit `count: 3`. Le panneau des
/// « guides manquants » ne doit afficher qu'une requête cherchée par PLUSIEURS
/// PERSONNES DISTINCTES (arbitrage du porteur), et ce fait n'était nulle part —
/// aucune colonne de `search_zero_results` ne pouvait le porter, puisqu'il y faut
/// une ligne par personne.
///
/// CE QU'ELLE NE CONTIENT PAS, ET C'EST LA RÈGLE DURE DU §2.4 : aucun identifiant
/// de membre. `seeker_hash` est un HMAC-SHA256 de `queryNormalized | userId` sous
/// une sous-clé dérivée du secret applicatif — la même construction que le lien de
/// désabonnement des notifications. Deux conséquences voulues :
///   · la requête ENTRE dans le condensat, donc le même membre porte un pseudonyme
///     DIFFÉRENT sur chaque requête : ces lignes ne se recollent pas en profil ;
///   · le secret n'est pas en base, donc une fuite de la base seule ne remonte à
///     personne.
///
/// `city_id` est une colonne SANS clé étrangère, délibérément : la déclarer en
/// relation imposerait une liste de retour sur `City`, dans un autre fichier de
/// schéma que ce lot n'a pas à toucher, et une ville supprimée ne laisse ici qu'un
/// pseudonyme orphelin — qui ne désigne rien et ne fausse aucun comptage, puisque
/// le filtre par ville ne retrouvera plus ces lignes.
model SearchZeroResultSeeker {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  queryNormalized String   @map("query_normalized")
  cityId          String?  @map("city_id") @db.Uuid
  occurredOn      DateTime @map("occurred_on") @db.Date
  /// HMAC, jamais un identifiant. 64 caractères hexadécimaux.
  seekerHash      String   @map("seeker_hash")

  /// L'unicité porte sur une colonne NULLABLE (`city_id`), et PostgreSQL tient deux
  /// NULL pour distincts : elle ne suffit donc PAS à dédupliquer une recherche sans
  /// ville. C'est `recordZeroResult` qui dédoublonne, sous le verrou consultatif
  /// qu'il pose déjà sur (requête, ville, jour) — exactement comme pour le compteur.
  /// La contrainte reste utile pour tous les cas AVEC ville, et comme garde-fou.
  @@unique([queryNormalized, cityId, occurredOn, seekerHash])
  @@index([queryNormalized, occurredOn])
  @@map("search_zero_result_seekers")
}

/// Notification in-app. Table en ajout seul.
model Notification {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String  @map("user_id") @db.Uuid
  /// Ex. help.response_received, journey.step_due.
  type   String
  title  String
  body   String?

  refType String? @map("ref_type")
  refId   String? @map("ref_id") @db.Uuid

  readAt       DateTime? @map("read_at") @db.Timestamptz
  /// IN_APP · PUSH · EMAIL — ce qui a effectivement été envoyé.
  channelsSent String[]  @map("channels_sent")

  // Colonne ajoutée par 11-recherche-12-notifications.md §3.
  /// JOURNEY_DEADLINE · JOURNEY_TEAM · HELP · MENTORSHIP · COMMUNITY · SERVICES ·
  /// MODERATION · BOOKMARK · SOCIAL · ACCOUNT — pilote les canaux autorisés.
  category String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

/// Réglages par canal et par catégorie.
model NotificationPreferences {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// { catégorie: bool }
  push         Json
  email        Json
  weeklyDigest Boolean @map("weekly_digest")
  /// Plage horaire sans notification push.
  quietHours   Json?   @map("quiet_hours")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Abonnements Web Push (VAPID). La permission n'est demandée qu'APRÈS une action
/// explicite du membre (§10.4) — jamais au chargement.
model PushSubscription {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userId    String  @map("user_id") @db.Uuid
  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String? @map("user_agent")

  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  /// Supprimé après 5 échecs.
  failureCount  Int       @default(0) @map("failure_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Journal des envois email / SMS / push, avec réessais exponentiels.
model OutboundMessage {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  channel  NotificationChannel
  userId   String?             @map("user_id") @db.Uuid
  template String
  status   OutboundStatus

  providerRef String?   @map("provider_ref")
  error       String?
  sentAt      DateTime? @map("sent_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([channel])
  @@index([userId])
  @@index([status])
  @@map("outbound_messages")
}
