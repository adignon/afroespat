# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ROLE=api                       # api | worker (§3.1)
APP_NAME=DisaporyPlus
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
DEFAULT_TIMEZONE=Europe/Paris

# ── Données ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
REDIS_URL=redis://localhost:6379

# ── Secrets (§11.2 — l'application refuse de démarrer si l'un manque) ────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-000000000000
CURSOR_SECRET=dev-cursor-secret-change-me-00000000000000
# Clé de chiffrement des téléphones : JAMAIS rotée (runbook §7), 32 octets en base64.
PHONE_ENCRYPTION_KEY=ZGV2LXBob25lLWtleS0zMi1ieXRlcy0wMDAwMDAwMDA=
PHONE_HMAC_KEY=dev-phone-hmac-key-change-me-0000000000
# Clé de chiffrement des contenus (notes d'étape, messages) : rotée tous les 12 mois.
CONTENT_ENCRYPTION_KEY=ZGV2LWNvbnRlbnQta2V5LTMyLWJ5dGVzLTAwMDAwMDA=

# ── Stockage objet (région UE en production — règle dure §8.2) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Fournisseurs externes ────────────────────────────────────────────────────
# En local et en test : FAKE partout (§11.3). Aucun appel sortant, aucun coût.
SMS_PROVIDER=fake                  # fake | twilio
SMS_FAKE_FIXED_CODE=123456
EMAIL_PROVIDER=fake                # fake | brevo
EMAIL_SMTP_URL=smtp://localhost:1025
PUSH_PROVIDER=fake                 # fake | webpush
KYC_PROVIDER=fake                  # fake | didit
PAYMENT_PROVIDER=fake              # fake | stripe
MOBILE_MONEY_PROVIDER=fake         # fake | <agrégateur UEMOA, à désigner — D4>
AI_MODERATION_PROVIDER=fake        # fake | anthropic
CAPTCHA_PROVIDER=fake              # fake | turnstile
ANTIVIRUS_HOST=localhost
ANTIVIRUS_PORT=3310

# ── Supervision ──────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# Tâches planifiées de §9.3, dans le worker. `false` coupe les balayages sans
# couper le worker (les files et le relais de la boîte d'envoi continuent) :
# c'est l'interrupteur d'incident du runbook §5.
SCHEDULER_ENABLED=true
