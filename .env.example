# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ROLE=api                       # api | worker (§3.1)
APP_NAME=DisaporyPlus
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
DEFAULT_TIMEZONE=Europe/Paris

# ── Données ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
REDIS_URL=redis://localhost:6379

# ── Secrets (§11.2 — l'application refuse de démarrer si l'un manque) ────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-000000000000
CURSOR_SECRET=dev-cursor-secret-change-me-00000000000000
# Clé de chiffrement des téléphones : JAMAIS rotée (runbook §7), 32 octets en base64.
PHONE_ENCRYPTION_KEY=ZGV2LXBob25lLWtleS0zMi1ieXRlcy0wMDAwMDAwMDA=
PHONE_HMAC_KEY=dev-phone-hmac-key-change-me-0000000000
# Clé de chiffrement des contenus (notes d'étape, messages) : rotée tous les 12 mois.
CONTENT_ENCRYPTION_KEY=ZGV2LWNvbnRlbnQta2V5LTMyLWJ5dGVzLTAwMDAwMDA=

# ── Stockage objet (région UE en production — règle dure §8.2) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Fournisseurs externes ────────────────────────────────────────────────────
# En local et en test : FAKE partout (§11.3). Aucun appel sortant, aucun coût.
SMS_PROVIDER=fake                  # fake | twilio
SMS_FAKE_FIXED_CODE=123456
EMAIL_PROVIDER=fake                # fake | brevo
EMAIL_SMTP_URL=smtp://localhost:1025
PUSH_PROVIDER=fake                 # fake | webpush
KYC_PROVIDER=fake                  # fake | didit
# Signe le webhook Didit (01 §4.3). Exigé dès que KYC_PROVIDER n'est plus fictif.
DIDIT_WEBHOOK_SECRET=dev-didit-webhook-secret-change-me
PAYMENT_PROVIDER=fake              # fake | stripe
MOBILE_MONEY_PROVIDER=fake         # fake | <agrégateur UEMOA, à désigner — D4>
AI_MODERATION_PROVIDER=fake        # fake | anthropic
CAPTCHA_PROVIDER=fake              # fake | turnstile
ANTIVIRUS_HOST=localhost
ANTIVIRUS_PORT=3310

# ── Supervision ──────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# Tâches planifiées de §9.3, dans le worker. `false` coupe les balayages sans
# couper le worker (les files et le relais de la boîte d'envoi continuent) :
# c'est l'interrupteur d'incident du runbook §5.
SCHEDULER_ENABLED=true

# Limite de débit (§5.5) : 120 requêtes/min et 30 écritures/min par membre, plus
# la limite propre à chaque route déclarée par @RateLimit(n).
# À laisser à `true` en production. À mettre à `false` en développement local si
# vous lancez la suite d'intégration : des dizaines de tests appellent la même
# route depuis la même IP, et la limite les ferait échouer sans rapport avec ce
# qu'ils éprouvent. Le test de la limite elle-même fournit sa propre
# configuration et ne dépend pas de cette variable.
RATE_LIMIT_ENABLED=true

# ── Ville pilote (02 §2.2, T3 B.2) ───────────────────────────────────────────
# LAQUELLE est la ville pilote n'est PAS une variable d'environnement : c'est
# `PILOT_CITY_SLUG` dans @app/shared — Paris — et cela se change là, en une ligne.
# Ces deux interrupteurs ne disent que SI le seed a le droit de l'ouvrir. Ils sont
# refusés en production : le jour du lancement, la ville s'ouvre en back-office
# (`POST /v1/admin/ref/cities/:id/activate`), seul chemin qui crée son réseau CITY
# et y inscrit les membres déjà rattachés.
# `true` ouvre la ville pilote en développement — sans elle, la carte, l'annuaire
# des villes et leur indexation sont intestables.
SEED_ACTIVATE_PILOT_CITY=false
# Ouvre une AUTRE ville que la pilote, pour un essai local. Vide = pilote.
SEED_PILOT_CITY_SLUG=

# ── Premier compte d'équipe (15 §2.2) ────────────────────────────────────────
# NORMALEMENT VIDES, et elles doivent le rester. Elles ne servent qu'une fois, le
# temps d'une commande, sur une base où AUCUN compte d'équipe n'existe encore :
#
#     pnpm --filter @app/api staff:bootstrap
#
# Sans elles, la commande REFUSE de s'exécuter et nomme ce qui manque. Il n'y a
# aucun mot de passe par défaut, et il n'y en aura pas : un secret écrit dans le
# dépôt est un secret publié. La commande refuse aussi dès qu'un compte d'équipe
# existe — sinon elle serait une porte dérobée permanente.
#
# TROIS CHOSES RESTENT À TRANCHER PAR LE PORTEUR, et aucune n'est dans la spec :
#   · QUI est le premier administrateur (l'adresse ci-dessous) ;
#   · PAR QUEL CANAL il reçoit son mot de passe (rien ne l'envoie d'ici) ;
#   · CE QUI SE PASSE S'IL LE PERD : aucune route ne réinitialise un mot de passe
#     d'équipe, et la commande refuse de rejouer. Les « codes de secours » de la
#     planche D01 ne sont pas implémentés. La seule reprise est un accès base.
#
# Le mot de passe suit la politique de POST /v1/admin/staff : 12 caractères
# minimum, hors liste des mots de passe trop courants. Le compte créé devra
# ENRÔLER SA DOUBLE AUTHENTIFICATION à la première connexion (§2.1, D01).
#
# À passer en ligne de commande plutôt qu'écrit ici, pour ne pas le laisser sur
# le disque — et préfixé d'une espace, pour qu'il n'entre pas dans l'historique :
#      STAFF_BOOTSTRAP_EMAIL=… STAFF_BOOTSTRAP_PASSWORD=… pnpm --filter @app/api staff:bootstrap
STAFF_BOOTSTRAP_EMAIL=
STAFF_BOOTSTRAP_DISPLAY_NAME=
STAFF_BOOTSTRAP_PASSWORD=

# ── Signature des webhooks entrants (T4 §8) ──────────────────────────────────
# FACULTATIFS. Sans secret, tout webhook est REFUSÉ — c'est voulu : aucune clé
# Stripe n'existe et l'agrégateur Mobile Money n'est pas désigné (décision D4).
# Les valeurs ci-dessous ne servent qu'au développement et aux tests.
STRIPE_WEBHOOK_SECRET=dev-stripe-webhook-secret-0000000000
MOBILE_MONEY_WEBHOOK_SECRET=dev-momo-webhook-secret-00000000000
